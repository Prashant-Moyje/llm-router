# Copy to .env and fill in. Never commit .env.
# Free tier, no credit card: https://console.groq.com
GROQ_API_KEY=gsk_...

# Paid alternative
ANTHROPIC_API_KEY=sk-ant-...

# Serving
ROUTER_CONFIG=configs/groq.yaml
ROUTER_MODEL=artifacts/router.joblib
ROUTER_PROVIDER=groq
# Operating point chosen by scripts/04_simulate.py -> reports/headline.json
ROUTER_TAU=0.50
